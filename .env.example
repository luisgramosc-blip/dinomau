# Cliente (Vite expone solo variables con prefijo VITE_).
# Si dejas vacías las dos de Supabase, el juego arranca en "modo local"
# (monedero en el dispositivo, sin cuentas ni ranking).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
# Dominio público usado en los links de referido: https://<dominio>/r/CODIGO
VITE_PUBLIC_SITE_URL=http://localhost:5173

# ⚠️ NUNCA pongas la service_role key aquí ni en Cloudflare: solo vive en los
#    secretos de Supabase Edge Functions.

# --- Anuncios (Fase 9) ---
# mock = anuncio de prueba · adsense = Google AdSense · none = sin anuncios
# Si se deja vacío: adsense cuando hay VITE_ADSENSE_CLIENT, si no mock.
VITE_ADS_PROVIDER=
# ID de editor de AdSense (AdSense → Cuenta → Información de la cuenta), p. ej. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# on = Google sirve anuncios de prueba (para desarrollar sin riesgo para la cuenta)
VITE_ADSENSE_TEST=
# Correo que aparece en la política de privacidad (/privacy.html)
VITE_CONTACT_EMAIL=
