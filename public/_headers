# Cabeceras de Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)
# Archivos con hash en el nombre: se pueden guardar en caché para siempre
/static/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker siempre se revisa, así las actualizaciones llegan enseguida
/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
